# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp
.DS_Store

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site
docs/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

# Instance configuration and data are never versioned - only the shipped
# defaults, CI workflow files, and pkgdown's own config are exceptions.
*.yaml
!inst/config/episodic_default_config.yaml
!inst/config/episodic_default_style.yaml
!.github/**/*.yaml
!_pkgdown.yaml
*.yml
!inst/config/default.yml
!inst/config/palette.yml
!.github/**/*.yml
!_pkgdown.yml
*.sqlite
*.sqlite3
*.db
data/
*.env
.Renviron.*
*credential*
*secret*

