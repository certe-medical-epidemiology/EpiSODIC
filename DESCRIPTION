Package: EpiSODIC
Type: Package
Title: Epidemiological Signal Observation, Detection, Identification, and
    Classification
Version: 0.9.0
Authors@R: c(
    person(given = c("Matthijs", "S."),
           family = "Berends",
           role = c("aut", "cre"),
           email = "m.berends@certe.nl"),
